# Copy to .env for local work. Never commit real values.
NODE_ENV=development
PORT=4000

# Aiven: use the Service URI from the console, and paste the project CA certificate
# into DB_CA_CERT (\n escapes are accepted). Production refuses DB_TLS=off.
DATABASE_URL=mysql://root@127.0.0.1:3306/sehrawat_dev
DB_TLS=off
DB_CA_CERT=
DB_POOL_SIZE=5

# At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

# Exact origins, comma separated. Wildcards are not supported.
FRONTEND_ORIGINS=http://localhost:5173
# Base URL used inside invitation and recovery links.
FRONTEND_URL=http://localhost:5173

# Set COOKIE_DOMAIN=.your-domain when using app.your-domain and api.your-domain.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the service, used to find the client IP.
TRUST_PROXY_HOPS=1

BUSINESS_SLUG=sehrawat

# "dev" prints codes and links to this terminal, and production refuses it.
# "log" does the same but is allowed in production, as a stopgap until real
# adapters are added in src/providers. Anyone who can read the logs can sign in.
SMS_PROVIDER=dev
MAIL_PROVIDER=dev

# "otp" signs the owner in by SMS code. "password" needs no phone or SMS: it uses the
# password printed by create-owner. Set VITE_OWNER_LOGIN to match on the frontend.
OWNER_LOGIN=otp

JOB_RUNNER_ENABLED=true
