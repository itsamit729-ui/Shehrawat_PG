# Copy to .env for local work. Never commit real values.
NODE_ENV=development
PORT=4000

# Aiven: use the Service URI from the console, and paste the project CA certificate
# into DB_CA_CERT (\n escapes are accepted). Production refuses DB_TLS=off.
DATABASE_URL=mysql://root@127.0.0.1:3306/sehrawat_dev
DB_TLS=off
DB_CA_CERT=
DB_POOL_SIZE=5

# At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

# Exact origins, comma separated. Wildcards are not supported.
FRONTEND_ORIGINS=http://localhost:5173
# Base URL used inside invitation and recovery links.
FRONTEND_URL=http://localhost:5173

# Set COOKIE_DOMAIN=.your-domain when using app.your-domain and api.your-domain.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the service, used to find the client IP.
TRUST_PROXY_HOPS=1

BUSINESS_SLUG=sehrawat

# "dev" prints codes and links to this terminal. Production refuses it until a
# real provider adapter is added in src/providers.
SMS_PROVIDER=dev
MAIL_PROVIDER=dev

JOB_RUNNER_ENABLED=true
