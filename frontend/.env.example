# Set false and configure API URL when the real backend is deployed.
VITE_DEMO_MODE=true
# "password" signs the owner in without SMS. It must match OWNER_LOGIN on the backend.
VITE_OWNER_LOGIN=otp
# Public API origin only. Never put database passwords or provider secrets here.
VITE_API_BASE_URL=https://api.example.com/api/v1
